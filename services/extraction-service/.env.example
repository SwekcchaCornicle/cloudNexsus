# local = mocks; vertex = Google Gemini; aws = optional Bedrock adapters
EXTRACTION_MODE=local

# Optional AWS settings
AWS_REGION=ap-south-1
AWS_PROFILE=admin
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=

# Vertex AI settings: use exact Project ID, not display name or project number
GCP_PROJECT_ID=YOUR_REAL_PROJECT_ID
GCP_REGION=global
VERTEX_CHAT_MODEL=gemini-3.8-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024
APP_DATA_DIR=data
